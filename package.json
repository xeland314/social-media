{
  "name": "social-media",
  "private": true,
  "type": "module",
  "description": "Videos (Hyperframes) y carruseles diarios de @xeland314: código, estilos y log de publicaciones compartidos.",
  "scripts": {
    "new": "node scripts/new-video.mjs",
    "dev": "node scripts/run.mjs dev",
    "check": "node scripts/run.mjs check",
    "snapshot": "node scripts/run.mjs snapshot",
    "render": "node scripts/render.mjs",
    "log": "node scripts/log.mjs",
    "captions": "node scripts/log.mjs --captions",
    "gallery": "node scripts/gallery.mjs",
    "sync": "npm run calendar && npm run log && npm run gallery",
    "audio": "node scripts/make-audio.mjs && node scripts/make-music.mjs",
    "image": "node scripts/image.mjs",
    "calendar": "node scripts/calendar.mjs",
    "carousel": "node scripts/carousel.mjs",
    "plan": "node scripts/plan.mjs",
    "music": "node scripts/make-music.mjs"
  },
  "devDependencies": {
    "hyperframes": "0.9.26"
  }
